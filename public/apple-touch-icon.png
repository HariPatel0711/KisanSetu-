<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#064e3b"/>
      <stop offset="50%" stop-color="#047857"/>
      <stop offset="100%" stop-color="#0f766e"/>
    </linearGradient>
    <linearGradient id="leaf" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fde047"/>
      <stop offset="100%" stop-color="#34d399"/>
    </linearGradient>
    <linearGradient id="sun" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a"/>
      <stop offset="100%" stop-color="#f59e0b"/>
    </linearGradient>
  </defs>
  <!-- Background with safe zone padding -->
  <rect width="512" height="512" rx="128" fill="url(#bg)"/>
  
  <!-- Subtle circular halo -->
  <circle cx="256" cy="256" r="180" fill="#065f46" opacity="0.6"/>
  <circle cx="256" cy="180" r="48" fill="url(#sun)" opacity="0.9"/>
  
  <!-- Sprout / Plant Icon -->
  <path d="M256 380 V 230" stroke="#f1f5f9" stroke-width="20" stroke-linecap="round"/>
  
  <!-- Left Leaf -->
  <path d="M256 280 C 190 280, 150 210, 160 160 C 210 150, 260 210, 256 280 Z" fill="url(#leaf)"/>
  
  <!-- Right Leaf -->
  <path d="M256 240 C 320 240, 360 180, 350 130 C 300 120, 250 170, 256 240 Z" fill="#34d399"/>
  
  <!-- Earth / Furrow Lines -->
  <path d="M140 380 Q 256 360 372 380" stroke="#fbbf24" stroke-width="16" stroke-linecap="round" fill="none"/>
  <path d="M170 415 Q 256 400 342 415" stroke="#34d399" stroke-width="12" stroke-linecap="round" fill="none" opacity="0.8"/>
</svg>
